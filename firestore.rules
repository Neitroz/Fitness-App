rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50
        && (!data.keys().hasAny(['bio']) || data.bio is string && data.bio.size() <= 1000)
        && (!data.keys().hasAny(['photoURL']) || data.photoURL is string && data.photoURL.size() <= 2083)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp || data.createdAt is string)
        && (!data.keys().hasAny(['lastActive']) || data.lastActive is timestamp || data.lastActive is string)
        && (!data.keys().hasAny(['height']) || data.height is number)
        && (!data.keys().hasAny(['unit']) || data.unit is string)
        && (!data.keys().hasAny(['volumeTargets']) || data.volumeTargets is map)
        && (!data.keys().hasAny(['bodyMetrics']) || data.bodyMetrics is list);
    }

    function isValidManualPR(data) {
      return data.userId == request.auth.uid 
        && data.exerciseName is string && data.exerciseName.size() <= 100
        && data.weight is number && data.weight >= 0
        && data.reps is number && data.reps >= 0
        && data.date is string;
    }

    function isValidWorkout(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.date is string
        && data.entries is list;
    }

    // Path Rules

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'lastActive']);
    }

    match /manual_prs/{prId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Or filtered by userId? If they want community, public list is fine.
      allow create: if isSignedIn() && isValidManualPR(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidManualPR(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /workouts/{workoutId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidWorkout(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidWorkout(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
